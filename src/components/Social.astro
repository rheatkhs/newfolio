---
import { socialLinks } from  '../data/content.ts';
---
<div class="author border-bottom">
    <div class="social">
      {socialLinks.map((link) => (
        <a href={link.url} target="_blank" class="social-link" aria-label={link.name}>
          <Fragment set:html={link.icon} />
        </a>
      ))}
    </div>
</div>
<style is:global>
  .social {
    margin: 0 auto;
    display: flex;
    gap: 18px;
    align-items: center;
    justify-content: center;
    padding-bottom: 10px;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-400);
    opacity: 0.8;
    transition: all 0.25s ease;
  }

  .social-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .social-link svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
    color: var(--color-400);
    transition: color 0.25s ease, fill 0.25s ease;
  }

  .social-link:hover svg {
    color: var(--color-100);
    fill: currentColor;
  }

  .social-link:hover .ic-github {
    color: var(--color-100);
  }

  .social-link:hover .ic-linkedin {
    color: #0a66c2;
  }

  .social-link:hover .ic-email {
    color: #ea4335;
  }
</style>
