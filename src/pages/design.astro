---
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { pageTag, pageDescription, designTdk } from "../data/content";
import { designItems, designCategories } from "../data/design";
---

<BlogPostLayout
	title={designTdk.title || "Design & Artworks | Febiadi Wisnu Akbar"}
	description={designTdk.description || ""}
	keywords={designTdk.keywords || ""}
>
	<div class="post">
		<main class="post-wrapper design-page">
			<SectionHeader
				tag={pageTag.design}
				description={pageDescription.design}
			>
				Design & Artworks
			</SectionHeader>

			<!-- Filter categories -->
			<div class="design-filter-section border-top">
				<div class="filter-pills">
					<button class="filter-pill active" data-filter="all">
						All Artworks <span class="pill-count">({designItems.length})</span>
					</button>
					{designCategories.filter(c => c.slug !== 'all').map((cat) => (
						<button class="filter-pill" data-filter={cat.slug}>
							{cat.label}
						</button>
					))}
				</div>
			</div>

			<!-- Design Gallery Grid -->
			<div class="design-grid" id="design-grid">
				{designItems.map((item) => (
					<article 
						class="design-card" 
						data-category={item.categorySlug}
						data-id={item.id}
					>
						<div class="card-meta">
							<span class="meta-tag">- {item.category.toUpperCase()} -</span>
							<span class="meta-year">({item.year})</span>
						</div>

						<div class="card-image-wrap">
							<img 
								src={item.image} 
								alt={item.title} 
								loading="lazy" 
								class="card-image"
							/>
						</div>

						<div class="card-caption">
							<h3 class="card-title">{item.title}</h3>
							<p class="card-subtitle">{item.subtitle}</p>
							<p class="card-desc">{item.description}</p>
							<div class="card-tags">
								{item.tags.map((tag) => (
									<span class="tag-pill">{tag}</span>
								))}
							</div>
						</div>
					</article>
				))}
			</div>
		</main>
	</div>
</BlogPostLayout>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// Filter Functionality
		const filterButtons = document.querySelectorAll('.filter-pill');
		const cards = document.querySelectorAll('.design-card');

		filterButtons.forEach(btn => {
			btn.addEventListener('click', () => {
				filterButtons.forEach(b => b.classList.remove('active'));
				btn.classList.add('active');

				const targetFilter = btn.getAttribute('data-filter');

				cards.forEach(card => {
					const category = card.getAttribute('data-category');
					if (targetFilter === 'all' || category === targetFilter) {
						card.style.display = 'flex';
						setTimeout(() => {
							card.style.opacity = '1';
							card.style.transform = 'translateY(0)';
						}, 20);
					} else {
						card.style.opacity = '0';
						card.style.transform = 'translateY(12px)';
						setTimeout(() => {
							card.style.display = 'none';
						}, 250);
					}
				});
			});
		});
	});
</script>

<style lang="scss">
.design-page {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.design-filter-section {
	margin-top: 1.5rem;
	padding-top: 1.25rem;
	display: flex;
	justify-content: center;
}

.filter-pills {
	display: flex;
	gap: 10px;
	flex-wrap: wrap;
	justify-content: center;
}

.filter-pill {
	display: inline-flex;
	align-items: center;
	gap: 4px;
	border-radius: 9999px;
	background-color: var(--filter-bg);
	border: 1px solid var(--border);
	color: var(--color-200);
	font-family: var(--font-body);
	font-size: 13.5px;
	padding: 8px 18px;
	cursor: pointer;
	line-height: 1;
	transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);

	.pill-count {
		font-size: 12px;
		opacity: 0.7;
	}

	&:hover {
		background-color: var(--filter-bg-hover);
		color: var(--color-100);
	}

	&.active {
		background: var(--filter-bg-active);
		color: var(--filter-color-active);
		font-weight: 500;
		border-color: var(--filter-bg-active);
	}
}

.design-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 32px;
	margin-top: 2.5rem;
	width: 100%;

	@media (max-width: 860px) {
		grid-template-columns: 1fr;
		gap: 24px;
	}
}

.design-card {
	display: flex;
	flex-direction: column;
	background: rgba(255, 255, 255, 0.02);
	border: 1px solid var(--border);
	border-radius: 12px;
	padding: 16px;
	box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
	transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);

	&:hover {
		border-color: var(--color-400);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
		transform: translateY(-2px);
	}
}

.card-meta {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 12px;
	font-size: 12px;
	color: var(--color-300);
	letter-spacing: 0.5px;

	.meta-tag {
		font-weight: 500;
	}
}

.card-image-wrap {
	position: relative;
	width: 100%;
	aspect-ratio: 1 / 1;
	border-radius: 8px;
	overflow: hidden;
	background: #0d1117;
	border: 1px solid rgba(255, 255, 255, 0.06);

	.card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		pointer-events: none;
		user-select: none;
	}
}

.card-caption {
	margin-top: 16px;
	display: flex;
	flex-direction: column;
	gap: 6px;
}

.card-title {
	font-size: 18px;
	font-weight: 600;
	color: var(--color-100);
	letter-spacing: -0.2px;
	margin: 0;
}

.card-subtitle {
	font-size: 13.5px;
	font-weight: 500;
	color: var(--color-300);
	margin: 0;
}

.card-desc {
	font-size: 13px;
	color: var(--color-400);
	line-height: 1.55;
	margin: 4px 0 8px;
}

.card-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
}

.tag-pill {
	display: inline-block;
	background: rgba(128, 128, 128, 0.1);
	border: 1px solid var(--border);
	color: var(--color-300);
	font-size: 11px;
	font-weight: 500;
	padding: 3px 8px;
	border-radius: 4px;
	letter-spacing: 0.5px;
}
</style>
