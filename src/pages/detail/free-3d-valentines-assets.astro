---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import CallToAction from "../../components/CallToAction.astro";

const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/free-3d-valentines-assets/*.{jpg,png,webp}', {
		eager: true,
	})
);


---
<DetailPostLayout
	title="Free Valentine's Day 3D Blender Assets | Febiadi Wisnu Akbar"
	description="Free 3D blender assets and icon pack suitable for modern UI, web applications, and landing pages."
	keywords="3D Icons, Blender Assets, Valentines Day, Web UI, Febiadi Wisnu Akbar"
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="3D ASSETS"
			description="">
					<h1 class="font-type">
						Valentine's Day 3D Blender Assets
					</h1>
			</DetailHeader>

				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title" style="margin-bottom:1em;">Free 3D Icons Pack - Valentine's Day</h3>

							<p>Those Valentine's Day 3D Icons are suitable for UI design, Web design, Landing pages, and more.</p>
							</p>
							<p class="post-desc">
								- 3D Blender Files (Fully customizable)
								- White and Pink Color Styles Files
								- High Resolution Images 3000x3000 (PNG)
							</p>
						</div>
						<div class="col-1a">
								<p style="margin-top: 12px;">👉 Download:</p>
								<div class="btn btn-grid" style="margin-top: 12px;">
									<CallToAction  target="_blank" href="http://web.606design.art/landings/004-free-3d-valentines-assets/">Landing Page </CallToAction>
									<CallToAction  target="_blank" href="https://www.figma.com/community/file/1363451172790940214/free-3d-icons-valentines-day/">Open Figma</CallToAction>
									<CallToAction  target="_blank" href="https://drive.google.com/drive/folders/171VScCkzSfubCOp_wQRnyMmUTBWGPJEe">Google Drive
									</CallToAction>
								</div>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
	.btn-grid{
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}
</style>
