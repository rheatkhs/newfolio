---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import CallToAction from "../../components/CallToAction.astro";
import coverImage from "../../assets/projects/cover/cover-mevia.png";
---
<DetailPostLayout
	title="MEVIA 3D - Modern Eco Virtual Interactive Adventure | Febiadi Wisnu Akbar"
	description="Modern Eco Virtual Interactive Adventure (MEVIA 3D) is the official 3D interactive environmental education platform for SMA Don Bosco 2 Jakarta featuring 3D waste sorting simulation and gamified eco challenges."
	keywords="MEVIA 3D, SMA Don Bosco 2 Jakarta, Bank Sampah 3D, Eco Challenge, Three.js, Gamification, EdTech, Environmental Education, Febiadi Wisnu Akbar"
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
				tag="3D INTERACTIVE SIMULATION & EDTECH"
				description="Modern Eco Virtual Interactive Adventure — SMA Don Bosco 2 Jakarta">
				<h1 class="font-type">
					MEVIA 3D
				</h1>
			</DetailHeader>

			<section>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Project Overview</h3>
							<p class="post-desc">
								<strong>MEVIA 3D (Modern Eco Virtual Interactive Adventure)</strong> is the official 3D interactive environmental education platform developed for SMA Don Bosco 2 Jakarta. Designed to transform conventional ecological learning into an engaging digital adventure, MEVIA combines interactive 3D simulations, gamified board mechanics, and campus-wide leaderboards to instill genuine sustainability habits in students.
							</p>

							<h3 class="post-title" style="margin-top:2rem;">Core Architecture & Capabilities</h3>
							<ul class="achievement-list">
								<li><strong>Bank Sampah 3D (Interactive Waste Sorting):</strong> A fast-paced 60-second real-time simulation challenging players to rapidly identify, categorize, and deposit 28 types of realistic waste items into 5 specialized sorting bins: Organik, Anorganik, Kertas, B3 (Hazardous), and Residu.</li>
								<li><strong>Eco Challenge Board Game:</strong> A turn-based digital board game driven by dice rolling physics, branching environmental dilemmas, and 5 standalone mini-games reinforcing carbon reduction, resource recycling, and conservation knowledge.</li>
								<li><strong>Duta Lingkungan & Gamified Leaderboards:</strong> Campus ranking system recognizing student achievements across 5 honorary environmental ambassador tiers, driving engagement through badges and live class standings.</li>
								<li><strong>Optimized WebGL 3D Engine:</strong> Powered by Three.js with lightweight asset bundling and efficient geometry meshes, ensuring smooth 60 FPS execution on budget school laptops, tablets, and smartphones.</li>
								<li><strong>Educational Portal & Teacher Dashboards:</strong> Student authentication system providing educators with analytics on sorting accuracy, completion rates, and learning progress.</li>
							</ul>

							<h3 class="post-title" style="margin-top:2rem;">Engineering Highlights</h3>
							<ul class="achievement-list">
								<li>Crafted with modern responsive layouts and Tailwind CSS, featuring fresh mint-green aesthetic and accessible UI contrasts.</li>
								<li>Implemented physics-based drag interactions and audio cues for immediate tactile feedback during 3D sorting drills.</li>
								<li>Constructed with privacy-conscious client-server communication tailored for K-12 school environments.</li>
							</ul>
						</div>

						<div class="col-1a" style="margin-top:2rem;">
							<div class="btn">
								<CallToAction href="https://www.mevia.web.id" target="_blank">
									Explore MEVIA 3D
								</CallToAction>
								<CallToAction href="/project" target="_self">
									Back to Projects
								</CallToAction>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section class="preview">
				<picture class="picture">
					<Image src={coverImage} alt="MEVIA 3D Platform Preview" loading="lazy" decoding="async" />
				</picture>
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
.achievement-list {
	list-style: disc;
	padding-left: 1.5rem;
	margin: 1rem 0;
	color: var(--color-200);
	line-height: 1.8;
}
.achievement-list li {
	margin-bottom: 0.5rem;
}
.picture img {
	width: 100%;
	height: auto;
	border-radius: 8px;
	border: 1px solid var(--color-700);
}
</style>
