---
import { Image } from "astro:assets";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import PostHeader from "../../components/PostHeader.astro";
const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/travel/*.{jpg,png,webp}', {
		eager: true,
	})
);
// Import image assets
---
<DetailPostLayout
	title="Tink Life - Diary & Travel App | Febiadi Wisnu Akbar"
	description="Mobile-first web application featuring travel logs, photo stories, and fluid UI interactions."
	keywords="Diary Life, Travel App, Mobile Web, Frontend, Febiadi Wisnu Akbar"
>
	<div class="post">
		<main class="post-wrapper">
				<PostHeader
					tag="Project"
					description="">
						<h1 class="font-type">
							Tink Travel & Diary Life
						</h1>
				</PostHeader>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Technology Stack: Figma & Vue</h3>
							<p class="post-desc">
								A mobile-first web journal application designed and engineered to document journeys and photo diaries, featuring rich micro-interactions and smooth navigation.
							</p>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
.icon{
	color:var(--color-900);
}
</style>

<script>
	var images = document.getElementsByTagName('img');
 	for (var i = 0; i < images.length; i++) {
	// Add draggable="false" attribute to images
	images[i].setAttribute('draggable', 'false');
	images[i].setAttribute('ref', 'nofollow');
  }
</script>
