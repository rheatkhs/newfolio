---
import { Image } from "astro:assets";
import DetailHeader from "../../components/DetailHeader.astro";
import DetailPostLayout from "../../layouts/DetailPostLayout.astro";
import CallToAction from "../../components/CallToAction.astro";

// Load project images automatically
const images = Object.values(
	import.meta.glob<{ default: ImageMetadata }>('../../assets/projects/todo/*.{jpg,png,webp}', {
		eager: true,
	})
);

---
<DetailPostLayout
	title="Todo List Online | Febiadi Wisnu Akbar"
	description="Minimalist Todo List web application with local storage persistence and clean responsive UI."
	keywords="Todo List, Web App, Productivity, JavaScript, Frontend, Febiadi Wisnu Akbar"
>
	<div class="post">
		<main class="post-wrapper">
			<DetailHeader
			tag="WEBSITE"
			description="">
					<h1 class="font-type">
						Todo List Online
					</h1>
			</DetailHeader>

			<section>
				<div class="content">
					<div class="row desc">
						<div class="col-1a">
							<h3 class="post-title">Todo 1.0 - Vue & Modern Web</h3>
							<p class="post-desc">
								A lightweight, responsive Todo List web application with zero registration required. All task data is preserved in browser local storage. Built with a clean component architecture to assist with daily productivity.
							</p>
						</div>
						<div class="col-1a">
							<p>
								<div class="btn">
									<CallToAction href="https://todo.uiineed.com/" target="_blank">
										Live Demo
									</CallToAction>
									<CallToAction href="https://github.com/ricocc/uiineed-todo-list" target="_blank">
										Github
									</CallToAction>
								</div>
							</p>
						</div>
					</div>
				</div>
			</section>
			<section class="preview">
				{images.map((img, index) => (
					<picture class="gsap-picture">
					  <Image src={img.default} alt={`Image ${index + 1}`}   loading="lazy" decoding="async" />
					</picture>
				  ))}
			</section>
		</main>
	</div>
</DetailPostLayout>

<style>
img{
	border:1px solid #ececec;
}
.btn{
	display: flex;
	gap: 16px;
}
</style>
