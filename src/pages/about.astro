---
import { Image } from 'astro:assets';
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageTag, pageDescription, aboutTdk } from '../data/content';
import myPortrait from "../assets/portrait.jpg";
import { certificates } from '../data/certificates';
---
<BlogPostLayout
	title={aboutTdk.title || ''}
	description={aboutTdk.description || ''}
	keywords={aboutTdk.keywords || ''}
>

	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}>
				 About Me
			</SectionHeader>

			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image src={myPortrait} alt="Febiadi Wisnu Akbar portrait" width="88" height="88" class="portrait">
					</div>
					<p>
						I am <strong style="font-size:1.2em">Febiadi Wisnu Akbar</strong>, a Software Engineer & Graphic Designer at <strong>DINKOMINFO Kota Pekalongan</strong>, based in Pekalongan, Indonesia.
					</p>
					<p>
						I specialize in building secure, scalable web and mobile applications with a security-first engineering mindset, combined with creative art direction in poster design, typography, and visual branding.
					</p>
				</div>
			</section>

			<section>
				<h3 class="post-title">Core Expertise</h3>
				<div class="content">
					<div class="skills-grid">
						<div class="skill-card">
							<h4>Web Development</h4>
							<p>Building high-performance, accessible applications with Next.js, React, Node.js, Astro, and PHP.</p>
						</div>
						<div class="skill-card">
							<h4>Mobile Development</h4>
							<p>Crafting cross-platform mobile experiences with fluid interfaces using Flutter and Dart.</p>
						</div>
						<div class="skill-card">
							<h4>Visual & Graphic Design</h4>
							<p>Creating expressive poster art, Swiss typography, anime graphics, and branding using Photoshop, Illustrator, and Figma.</p>
						</div>
						<div class="skill-card">
							<h4>Security Research</h4>
							<p>Bug bounty hunting on platforms like HackerOne and Bugcrowd, government security audits, and OWASP modeling.</p>
						</div>
						<div class="skill-card">
							<h4>Backend & Systems</h4>
							<p>Architecting robust REST APIs, caching layers with Redis, and resilient database schemas.</p>
						</div>
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Experience</h3>
				<div class="content timeline">
					<div class="timeline-item">
						<h4>Programmer <span>— DINKOMINFO Kota Pekalongan</span></h4>
						<ul>
							<li>Developing and maintaining internal web applications for municipal government digital services.</li>
							<li>Implementing secure and scalable backend solutions using PHP and Node.js.</li>
							<li>Collaborating with cross-functional teams to improve public digital platforms and data security.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<h4>Front-End Developer</h4>
						<ul>
							<li>Leading front-end development of creative digital products and responsive web applications.</li>
							<li>Implementing clean, high-performance user interfaces using modern JavaScript frameworks.</li>
							<li>Working closely with backend engineers to integrate APIs and streamline UX delivery.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<h4>IT Support</h4>
						<ul>
							<li>Maintained campus IT infrastructure, local area networks, and server systems.</li>
							<li>Troubleshot hardware, software, and connectivity issues across institutional facilities.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<h4>Lab Assistant</h4>
						<ul>
							<li>Guided students during hands-on laboratory sessions for programming and computer networking.</li>
							<li>Maintained lab workstations and collaborated with faculty to refine practical exercises.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Licenses & Certifications Section -->
			<section>
				<h3 class="post-title">Licenses & Certifications</h3>
				<div class="content">
					<div class="certs-list">
						{certificates.map((cert) => (
							<div class="cert-card">
								<div class="cert-media">
									<a href={cert.pdfUrl} target="_blank" class="cert-thumb-link" aria-label={`View ${cert.title} certificate PDF`}>
										<img src={cert.image} alt={cert.title} loading="lazy" class="cert-thumb" />
										<div class="cert-overlay">
											<span>
												<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
													<polyline points="15 3 21 3 21 9"></polyline>
													<line x1="10" y1="14" x2="21" y2="3"></line>
												</svg>
												Open PDF
											</span>
										</div>
									</a>
								</div>
								<div class="cert-body">
									<div class="cert-header">
										<span class="cert-badge">{cert.badge}</span>
										<span class="cert-category">&bull; {cert.category}</span>
									</div>
									<h4 class="cert-title">{cert.title}</h4>
									<p class="cert-issuer">{cert.issuer} &bull; <span class="cert-org">{cert.organization}</span></p>
									<div class="cert-meta">
										<span class="cert-date">Issued: {cert.issueDate}</span>
										{cert.hours && <span class="cert-hours">&bull; {cert.hours}</span>}
									</div>
									<div class="cert-cred-row">
										<span class="cred-label">Credential ID:</span>
										<code class="cred-code">{cert.credentialId}</code>
									</div>
									<div class="cert-skills">
										{cert.skills.map(skill => (
											<span class="skill-pill">{skill}</span>
										))}
									</div>
									<div class="cert-actions">
										<a href={cert.pdfUrl} target="_blank" class="cert-btn-primary">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
												<polyline points="14 2 14 8 20 8"></polyline>
												<line x1="16" y1="13" x2="8" y2="13"></line>
												<line x1="16" y1="17" x2="8" y2="17"></line>
											</svg>
											View PDF Certificate
										</a>
										{cert.verifyUrl && (
											<a href={cert.verifyUrl} target="_blank" class="cert-btn-secondary">
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<circle cx="12" cy="12" r="10"></circle>
													<polyline points="12 6 12 12 16 14"></polyline>
												</svg>
												Online Verifier
											</a>
										)}
									</div>
								</div>
							</div>
						))}
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Education</h3>
				<div class="content">
					<div class="timeline-item">
						<h4>Informatics Engineering</h4>
						<p>Focused on Software Engineering, Web Development, and Cybersecurity. Active participant in local programming challenges and information security workshops.</p>
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Let's Build Something Great</h3>
				<div class="content">
					<p>
						Whether you have an engineering project in mind, a security assessment inquiry, or simply want to connect, my inbox is always open.
					</p>
					<p style="margin-top:24px;">
						<CallToAction
							target="_self"
							href="mailto:rheatkhs@gmail.com"
						>
							Get in Touch
						</CallToAction>
					</p>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style lang="scss">
	.about {
		display: flex;
		flex-direction: column;
		margin:0 auto;
	}
	p {
		margin: 0.75rem 0;
		line-height: 1.7;
	}
	.portrait {
		border-radius: 100px;
		margin: 12px 0 16px;
		overflow: hidden;
		text-align: left;
	}
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		margin: 1rem 0;
	}
	.skill-card {
		padding: 16px 20px;
		border: 1px solid var(--color-700);
		border-radius: 8px;
		background: var(--color-900);
		h4 {
			margin: 0 0 8px;
			font-size: 1rem;
			color: var(--color-100);
		}
		p {
			margin: 0;
			font-size: 0.875rem;
			color: var(--color-300);
			line-height: 1.5;
		}
	}
	.timeline {
		margin-top: 1rem;
	}
	.timeline-item {
		margin-bottom: 1.75rem;
		h4 {
			font-size: 1.1rem;
			color: var(--color-100);
			margin-bottom: 0.5rem;
			span {
				font-size: 0.95rem;
				font-weight: 400;
				color: var(--color-400);
			}
		}
		ul {
			list-style: disc;
			padding-left: 1.25rem;
			color: var(--color-300);
			line-height: 1.6;
		}
		li {
			margin-bottom: 0.35rem;
			font-size: 0.95rem;
		}
	}

	/* Licenses & Certifications */
	.certs-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin: 1.25rem 0;
	}
	.cert-card {
		display: flex;
		gap: 22px;
		padding: 20px;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.02);
		transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);

		&:hover {
			border-color: var(--color-400);
			box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
			transform: translateY(-2px);
		}

		@media (max-width: 768px) {
			flex-direction: column;
		}
	}
	.cert-media {
		width: 230px;
		flex-shrink: 0;

		@media (max-width: 768px) {
			width: 100%;
			max-width: 320px;
		}
	}
	.cert-thumb-link {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 1683 / 1190;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--border);
		background: #0d1117;

		.cert-thumb {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.35s ease;
		}
		.cert-overlay {
			position: absolute;
			inset: 0;
			background: rgba(0, 0, 0, 0.55);
			backdrop-filter: blur(2px);
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			transition: opacity 0.25s ease;
			span {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				background: rgba(16, 16, 16, 0.9);
				color: #fff;
				padding: 6px 14px;
				border-radius: 9999px;
				font-size: 12px;
				font-weight: 500;
				border: 1px solid rgba(255, 255, 255, 0.25);
			}
		}
		&:hover {
			.cert-thumb { transform: scale(1.04); }
			.cert-overlay { opacity: 1; }
		}
	}
	.cert-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.cert-header {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.cert-badge {
		font-size: 11px;
		font-weight: 600;
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(59, 130, 246, 0.12);
		border: 1px solid rgba(59, 130, 246, 0.25);
		color: #60a5fa;
		letter-spacing: 0.5px;
	}
	.cert-category {
		font-size: 11.5px;
		color: var(--color-400);
		letter-spacing: 0.5px;
	}
	.cert-title {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-100);
		margin: 2px 0 0;
		line-height: 1.35;
	}
	.cert-issuer {
		font-size: 0.875rem;
		color: var(--color-300);
		margin: 0;
		.cert-org {
			color: var(--color-400);
		}
	}
	.cert-meta {
		display: flex;
		gap: 8px;
		font-size: 0.8rem;
		color: var(--color-400);
		margin: 2px 0;
	}
	.cert-cred-row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
		font-size: 0.8rem;
		color: var(--color-400);
		margin-bottom: 2px;
		.cred-label {
			font-weight: 500;
		}
		.cred-code {
			font-family: monospace;
			font-size: 0.75rem;
			padding: 2px 8px;
			border-radius: 4px;
			background: rgba(128, 128, 128, 0.1);
			color: var(--color-200);
			border: 1px solid var(--border);
		}
	}
	.cert-skills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 4px 0 8px;
	}
	.skill-pill {
		font-size: 11px;
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border);
		color: var(--color-300);
	}
	.cert-actions {
		display: flex;
		gap: 10px;
		margin-top: auto;
		padding-top: 6px;
		flex-wrap: wrap;
	}
	.cert-btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		font-weight: 500;
		padding: 7px 16px;
		border-radius: 6px;
		background: var(--filter-bg-active);
		color: var(--filter-color-active) !important;
		text-decoration: none;
		transition: opacity 0.2s ease;
		&:hover { opacity: 0.85; }
	}
	.cert-btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		font-weight: 500;
		padding: 7px 16px;
		border-radius: 6px;
		background: transparent;
		border: 1px solid var(--border);
		color: var(--color-200) !important;
		text-decoration: none;
		transition: all 0.2s ease;
		&:hover {
			border-color: var(--color-400);
			color: var(--color-100) !important;
		}
	}

	a, a:link {
		color: var(--color-blue);
	}
</style>
