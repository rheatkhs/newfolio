---
import { Image } from 'astro:assets';
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import { pageTag, pageDescription, aboutTdk } from '../data/content';
import myPortrait from "../assets/portrait.jpg";
import { certificates, honorsRecognitions } from '../data/certificates';
---
<BlogPostLayout
	title={aboutTdk.title || ''}
	description={aboutTdk.description || ''}
	keywords={aboutTdk.keywords || ''}
>

	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}>
				 About Me
			</SectionHeader>

			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image src={myPortrait} alt="Febiadi Wisnu Akbar portrait" width="88" height="88" class="portrait">
					</div>
					<p>
						I am <strong style="font-size:1.2em">Febiadi Wisnu Akbar</strong>, a Software Engineer & Graphic Designer based in Pekalongan, Indonesia.
					</p>
					<p>
						I specialize in building secure, scalable web and mobile applications with a security-first engineering mindset, combined with creative art direction in poster design, typography, and visual branding.
					</p>
					<div style="margin-top: 1.25rem;">
						<a 
							href="/CV_Febiadi_Wisnu_Akbar.pdf" 
							target="_blank" 
							class="cv-hero-link"
							style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.875rem; font-weight: 500; color: var(--color-100); text-decoration: underline; text-underline-offset: 4px;"
						>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Download Curriculum Vitae (PDF) &rarr;
						</a>
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Core Expertise</h3>
				<div class="content">
					<div class="skills-grid">
						<div class="skill-card">
							<h4>Web Development</h4>
							<p>Building high-performance, accessible applications with clean architecture using Next.js, React, Node.js, Astro, and PHP.</p>
						</div>
						<div class="skill-card">
							<h4>Backend & Systems</h4>
							<p>Architecting robust RESTful APIs, secure authentication flows, and scalable database schemas using Node.js and PHP.</p>
						</div>
						<div class="skill-card">
							<h4>Mobile Development</h4>
							<p>Crafting cross-platform mobile experiences with fluid user interfaces and native performance using Flutter and Dart.</p>
						</div>
						<div class="skill-card">
							<h4>Security & System Hardening</h4>
							<p>Conducting vulnerability assessments, web application hardening, and responsible disclosure following OWASP standards.</p>
						</div>
						<div class="skill-card">
							<h4>AI & Modern Tooling</h4>
							<p>Integrating generative AI APIs, prompt engineering, and building developer productivity tools and open-source packages.</p>
						</div>
						<div class="skill-card">
							<h4>Visual & Graphic Design</h4>
							<p>Creating expressive poster art, Swiss typography, brand identity systems, and visual compositions in Figma and Photoshop.</p>
						</div>
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Experience</h3>
				<div class="content timeline">
					<div class="timeline-item">
						<div class="timeline-header">
							<h4>Software Engineer <span>— Dinas Komunikasi dan Informatika Kota Pekalongan</span></h4>
							<span class="timeline-date">2025 &mdash; Present</span>
						</div>
						<p class="timeline-location">Pekalongan, Indonesia</p>
						<ul>
							<li>Developing and maintaining internal web applications for local government services.</li>
							<li>Implementing secure and scalable backend solutions using PHP and Node.js.</li>
							<li>Collaborating with cross-functional teams to improve digital public services.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<div class="timeline-header">
							<h4>Front-End Developer <span>— OFFTHEGRID Development Team</span></h4>
							<span class="timeline-date">2022 &mdash; 2025</span>
						</div>
						<p class="timeline-location">Pekalongan, Indonesia</p>
						<ul>
							<li>Leading the front-end development of creative digital projects and web applications.</li>
							<li>Implementing responsive and high-performance user interfaces using modern frameworks.</li>
							<li>Collaborating with full-stack developers to deliver seamless user experiences.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<div class="timeline-header">
							<h4>IT Support <span>— Institut Widya Pratama</span></h4>
							<span class="timeline-date">2022 &mdash; 2023</span>
						</div>
						<p class="timeline-location">Pekalongan, Indonesia</p>
						<ul>
							<li>Maintaining campus IT infrastructure and providing technical assistance to students and staff.</li>
							<li>Troubleshooting hardware and software issues across the institution.</li>
							<li>Assisting in the management of local network and server systems.</li>
						</ul>
					</div>

					<div class="timeline-item">
						<div class="timeline-header">
							<h4>Lab Assistant <span>— Institut Widya Pratama</span></h4>
							<span class="timeline-date">2020 &mdash; 2022</span>
						</div>
						<p class="timeline-location">Pekalongan, Indonesia</p>
						<ul>
							<li>Assisted students in laboratory sessions for programming and networking courses.</li>
							<li>Maintained laboratory equipment and ensured a productive learning environment.</li>
							<li>Collaborated with faculty members to develop and refine lab materials.</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- Licenses & Certifications Section -->
			<section>
				<h3 class="post-title">Licenses & Certifications</h3>
				<div class="content">
					<div class="certs-list">
						{certificates.map((cert) => (
							<article class="cert-card">
								<a
									href={cert.pdfUrl}
									target="_blank"
									class="cert-thumb-link"
									aria-label={`View ${cert.title} certificate PDF`}
								>
									<img
										src={cert.image}
										alt={cert.title}
										loading="lazy"
										class="cert-thumb"
										style="width: 100%; height: auto; aspect-ratio: 1683 / 1190; object-fit: contain; display: block;"
									/>
								</a>

								<div class="cert-details">
									<div class="cert-row-top">
										<div class="cert-badge-group">
											<span class="cert-badge">{cert.badge}</span>
											<span class="cert-category">&bull; {cert.category}</span>
										</div>
										<div class="cert-actions">
											<a href={cert.pdfUrl} target="_blank" class="cert-btn-pdf">
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
													<polyline points="14 2 14 8 20 8"></polyline>
													<line x1="16" y1="13" x2="8" y2="13"></line>
													<line x1="16" y1="17" x2="8" y2="17"></line>
												</svg>
												<span>View PDF</span>
											</a>
											{cert.verifyUrl && (
												<a href={cert.verifyUrl} target="_blank" class="cert-btn-verify">
													<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
														<circle cx="12" cy="12" r="10"></circle>
														<polyline points="12 6 12 12 16 14"></polyline>
													</svg>
													<span>Verify</span>
												</a>
											)}
										</div>
									</div>

									<h4 class="cert-title">
										<a href={cert.pdfUrl} target="_blank">{cert.title}</a>
									</h4>

									<p class="cert-issuer">
										{cert.issuer} &bull; <span class="cert-org">{cert.organization}</span>
									</p>

									<div class="cert-meta">
										<span class="cert-meta-item">Issued: {cert.issueDate}</span>
										{cert.hours && <span class="cert-meta-item">&bull; {cert.hours}</span>}
										<span class="cert-meta-id">
											ID: <code class="cert-code">{cert.credentialId}</code>
										</span>
									</div>

									<div class="cert-skills">
										{cert.skills.map((skill) => (
											<span class="cert-skill-pill">{skill}</span>
										))}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- Honors & Recognitions Section -->
			<section>
				<h3 class="post-title">Honors & Recognitions</h3>
				<div class="content">
					<div class="certs-list">
						{honorsRecognitions.map((cert) => (
							<article class="cert-card">
								<a
									href={cert.pdfUrl}
									target="_blank"
									class="cert-thumb-link"
									aria-label={`View ${cert.title} certificate PDF`}
								>
									<img
										src={cert.image}
										alt={cert.title}
										loading="lazy"
										class="cert-thumb"
										style="width: 100%; height: auto; aspect-ratio: 1683 / 1190; object-fit: contain; display: block;"
									/>
								</a>

								<div class="cert-details">
									<div class="cert-row-top">
										<div class="cert-badge-group">
											<span class="cert-badge">{cert.badge}</span>
											<span class="cert-category">&bull; {cert.category}</span>
										</div>
										<div class="cert-actions">
											<a href={cert.pdfUrl} target="_blank" class="cert-btn-pdf">
												<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
													<polyline points="14 2 14 8 20 8"></polyline>
													<line x1="16" y1="13" x2="8" y2="13"></line>
													<line x1="16" y1="17" x2="8" y2="17"></line>
												</svg>
												<span>View PDF</span>
											</a>
										</div>
									</div>

									<h4 class="cert-title">
										<a href={cert.pdfUrl} target="_blank">{cert.title}</a>
									</h4>

									<p class="cert-issuer">
										{cert.issuer} &bull; <span class="cert-org">{cert.organization}</span>
									</p>

									<div class="cert-meta">
										<span class="cert-meta-item">Issued: {cert.issueDate}</span>
										<span class="cert-meta-id">
											ID: <code class="cert-code">{cert.credentialId}</code>
										</span>
									</div>

									<div class="cert-skills">
										{cert.skills.map((skill) => (
											<span class="cert-skill-pill">{skill}</span>
										))}
									</div>
								</div>
							</article>
						))}
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Education</h3>
				<div class="content timeline">
					<div class="timeline-item">
						<div class="timeline-header">
							<h4>Informatics Engineering <span>— Institut Widya Pratama</span></h4>
							<span class="timeline-date">Pekalongan, Indonesia</span>
						</div>
						<p class="timeline-location">Specialization in Software Engineering &amp; Cybersecurity</p>
						<ul>
							<li>Coursework and practical study in Software Engineering, Web Development, and Cybersecurity fundamentals.</li>
							<li>Engaged in academic software projects, practical laboratory sessions, and campus technology workshops.</li>
						</ul>
					</div>
				</div>
			</section>

			<section>
				<h3 class="post-title">Let's Build Something Great</h3>
				<div class="content">
					<p>
						Whether you have a software project in mind, a creative design inquiry, or just want to discuss an idea, feel free to reach out.
					</p>
					<div class="cta-actions" style="margin-top:24px; display: flex; gap: 12px; flex-wrap: wrap;">
						<CallToAction
							target="_self"
							href="mailto:rheatkhs@gmail.com"
						>
							Get in Touch
						</CallToAction>
						<CallToAction
							target="_blank"
							href="/CV_Febiadi_Wisnu_Akbar.pdf"
						>
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
								<polyline points="7 10 12 15 17 10"></polyline>
								<line x1="12" y1="15" x2="12" y2="3"></line>
							</svg>
							Download CV (PDF)
						</CallToAction>
					</div>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin: 0 auto;
	}
	p {
		margin: 0.75rem 0;
		line-height: 1.7;
	}
	.portrait {
		border-radius: 100px;
		margin: 12px 0 16px;
		overflow: hidden;
		text-align: left;
	}
	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 16px;
		margin: 1rem 0;
	}
	.skill-card {
		padding: 16px 20px;
		border: 1px solid var(--color-700);
		border-radius: 8px;
		background: var(--color-900);
	}
	.skill-card h4 {
		margin: 0 0 8px;
		font-size: 1rem;
		color: var(--color-100);
	}
	.skill-card p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-300);
		line-height: 1.5;
	}
	.timeline {
		margin-top: 1rem;
	}
	.timeline-item {
		margin-bottom: 2rem;
	}
	.timeline-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
	}
	.timeline-item h4 {
		font-size: 1.05rem;
		color: var(--color-100);
		margin: 0;
		line-height: 1.4;
	}
	.timeline-item h4 span {
		font-size: 0.95rem;
		font-weight: 400;
		color: var(--color-400);
	}
	.timeline-date {
		font-size: 0.8rem;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(128, 128, 128, 0.08);
		border: 1px solid var(--color-700);
		color: var(--color-300);
		white-space: nowrap;
	}
	.timeline-location {
		font-size: 0.8rem;
		color: var(--color-400);
		margin: 2px 0 6px;
	}
	.timeline-item ul {
		list-style: disc;
		padding-left: 1.25rem;
		color: var(--color-300);
		line-height: 1.6;
		margin: 0.4rem 0 0;
	}
	.timeline-item li {
		margin-bottom: 0.35rem;
		font-size: 0.95rem;
	}

	/* Licenses & Certifications - Compact & Professional */
	.certs-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin: 1rem 0;
	}

	.cert-card {
		display: flex;
		align-items: center;
		gap: 18px;
		padding: 14px 18px;
		border: 1px solid var(--color-700);
		border-radius: 10px;
		background: var(--color-900);
		transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
	}

	.cert-card:hover {
		border-color: var(--color-400);
		transform: translateY(-1px);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
	}

	.cert-thumb-link {
		position: relative;
		display: block;
		width: 140px;
		min-width: 140px;
		max-width: 140px;
		flex-shrink: 0;
		border-radius: 6px;
		overflow: hidden;
		border: 1px solid var(--color-700);
		background: var(--color-900);
		text-decoration: none !important;
	}

	.cert-thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 1683 / 1190;
		object-fit: contain;
		display: block;
		transition: transform 0.25s ease;
	}

	.cert-thumb-link:hover .cert-thumb {
		transform: scale(1.05);
	}

	.cert-details {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.cert-row-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
	}

	.cert-badge-group {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: wrap;
	}

	.cert-badge {
		font-size: 10.5px;
		font-weight: 600;
		padding: 1px 7px;
		border-radius: 4px;
		background: rgba(59, 130, 246, 0.12);
		border: 1px solid rgba(59, 130, 246, 0.25);
		color: #3b82f6;
		letter-spacing: 0.2px;
	}

	.cert-category {
		font-size: 11px;
		color: var(--color-400);
	}

	.cert-actions {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
	}

	.cert-btn-pdf,
	.cert-btn-verify {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 11.5px;
		font-weight: 500;
		padding: 4px 10px;
		border-radius: 6px;
		text-decoration: none !important;
		line-height: 1;
		transition: all 0.2s ease;
	}

	.cert-btn-pdf {
		border: 1px solid var(--color-700);
		background: rgba(128, 128, 128, 0.08);
		color: var(--color-100) !important;
	}

	.cert-btn-pdf:hover {
		border-color: var(--color-400);
		background: var(--color-700);
	}

	.cert-btn-verify {
		border: 1px solid rgba(59, 130, 246, 0.3);
		background: rgba(59, 130, 246, 0.08);
		color: #3b82f6 !important;
	}

	.cert-btn-verify:hover {
		background: rgba(59, 130, 246, 0.16);
	}

	.cert-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-100);
		margin: 2px 0 0;
		line-height: 1.35;
	}

	.cert-title a {
		color: inherit !important;
		text-decoration: none !important;
	}

	.cert-title a:hover {
		text-decoration: underline !important;
	}

	.cert-issuer {
		font-size: 0.8rem;
		color: var(--color-300);
		margin: 0;
		line-height: 1.4;
	}

	.cert-org {
		color: var(--color-400);
	}

	.cert-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 4px 8px;
		font-size: 0.775rem;
		color: var(--color-400);
		margin-top: 2px;
	}

	.cert-meta-item {
		white-space: nowrap;
	}

	.cert-meta-id {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.cert-code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.725rem;
		padding: 1px 6px;
		border-radius: 4px;
		background: rgba(128, 128, 128, 0.12);
		border: 1px solid var(--color-700);
		color: var(--color-200);
	}

	.cert-skills {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 6px;
		margin-top: 4px;
	}

	.cert-skill-pill {
		font-size: 10.5px;
		padding: 2px 7px;
		border-radius: 4px;
		background: rgba(128, 128, 128, 0.08);
		border: 1px solid var(--color-700);
		color: var(--color-300);
		line-height: 1.3;
	}

	@media (max-width: 640px) {
		.cert-card {
			flex-direction: column;
			align-items: stretch;
			gap: 12px;
			padding: 12px;
		}

		.cert-thumb-link {
			width: 140px;
		}

		.cert-row-top {
			flex-wrap: wrap;
		}

		.cert-actions {
			margin-top: 4px;
		}
	}

	a, a:link {
		color: var(--color-blue);
	}
</style>
