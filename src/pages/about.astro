---
import { Image } from 'astro:assets';
import BlogPostLayout from "../layouts/BlogPostLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CallToAction from "../components/CallToAction.astro";
import {pageTag, pageDescription,aboutTdk} from '../data/content';
import myPortrait from "../assets/portrait.jpg";
---
<BlogPostLayout
	title={aboutTdk.title || ''}
	description = {aboutTdk.description || ''}
	keywords = {aboutTdk.keywords || ''}
>

	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader
				tag={pageTag.about}
				description={pageDescription.about}>
				 About Me
			</SectionHeader>
			<section class="border-top" style="padding-top: 2rem;">
				<div class="content">
					<div>
						<Image src={myPortrait} alt="portrait" width="88" height="88" class="portrait">
					</div>
					<p>
						I am <strong style="font-size:1.2em">Febiadi Wisnu Akbar</strong>, a Software Engineer from Pekalongan, Indonesia. I focus on building reliable, performant web applications and software systems with clean architecture.
					</p>
					<p>
						I enjoy tackling complex engineering problems, designing scalable digital solutions, and continuously expanding my technical knowledge across the modern software stack.
					</p>

				</div>
			</section>
			<section>
				<h3 class="post-title">Beyond Engineering</h3>
				<div class="content">
					<p>
						Outside of my daily development work, I like to dedicate time to open-source projects, explore emerging technologies, and experiment with frontend and backend frameworks. I am also an avid coffee enthusiast who enjoys exploring different coffee beans and brewing recipes.
					</p>
					<p>I am always open to exciting collaborations, new ideas, and insightful tech discussions.</p>
					<p style="margin-top:24px;">
						<CallToAction
						target="_self"
						href="mailto:contact@febiadi.dev"
						>
							Get in Touch
						</CallToAction>
					</p>
				</div>
			</section>
			<p></p>
			<p></p>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		margin:0 auto;
	}
	p{
		margin:0.75rem 0;
	}
	figure{
		margin:2rem 0;
	}
	img{max-width: 100%;}
	.portrait{
		border-radius: 100px;
		margin:12px 0 12px;
		overflow: hidden;
		text-align: left;
	}
	a, a:link{
		color:var(--color-blue);
	}
</style>
